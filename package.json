{
  "name": "minimal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && bun run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply minimal-so --local",
    "db:migrate:remote": "wrangler d1 migrations apply minimal-so --remote",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "ext:dev": "web-ext run -s extension -t chromium --chromium-binary=/Applications/Helium.app/Contents/MacOS/Helium --chromium-profile=./extension-profile --keep-profile-changes",
    "ext:build": "web-ext build -s extension -a extension-dist --overwrite-dest"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@cloudflare/vite-plugin": "^1.39.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@orpc/client": "1.13.11",
    "@orpc/openapi": "1.13.11",
    "@orpc/server": "1.13.11",
    "@orpc/tanstack-query": "1.13.11",
    "@orpc/zod": "1.13.11",
    "@polar-sh/better-auth": "^1.8.1",
    "@polar-sh/sdk": "^0.43.1",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.18",
    "@vitejs/plugin-react": "^6.0.2",
    "agentation": "^2.0.0",
    "better-auth": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.29.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "motion": "^12.29.2",
    "react": "19.2.0",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.2.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "torph": "^0.0.5",
    "vaul": "^1.1.2",
    "vite": "^8.0.16",
    "workers-og": "^0.0.27",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.60.1",
    "web-ext": "^8.4.0",
    "wrangler": "^4.96.0"
  }
}
