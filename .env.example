# Client values. Vite puts them into the browser bundle at build time.
VITE_APP_URL=http://localhost:3000
VITE_CHROME_EXTENSION_ID=
VITE_DEFAULT_BILLING_CYCLE=yearly
VITE_POLAR_DISCOUNT_ID=

# drizzle-kit only (`bun run db:studio`). Not a Worker secret.
